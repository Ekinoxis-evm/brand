{
  "name": "@ekinoxis/brand",
  "version": "0.1.6",
  "description": "Ekinoxis brand source: tokens, logos, fonts and imagery for every Ekinoxis project.",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": "github:Ekinoxis-evm/brand",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.mjs"
    },
    "./tokens.json": "./tokens.json",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind": {
      "types": "./dist/tailwind-preset.d.cts",
      "default": "./dist/tailwind-preset.cjs"
    },
    "./fonts.css": "./fonts/fonts.css",
    "./fonts/*": "./fonts/*",
    "./logos/*": "./logos/*",
    "./favicon/*": "./favicon/*",
    "./imagery/*": "./imagery/*",
    "./social/*": "./social/*"
  },
  "files": [
    "dist",
    "tokens.json",
    "fonts",
    "logos",
    "favicon",
    "imagery",
    "social",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "logos": "node scripts/logos.mjs"
  },
  "devDependencies": {
    "opentype.js": "1.3.4"
  },
  "types": "./dist/tokens.d.ts"
}

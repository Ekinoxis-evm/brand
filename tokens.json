{
  "$description": "Ekinoxis brand tokens: the one source. Format: W3C Design Tokens (DTCG). Edit here, run `npm run build`, and dist/ regenerates.",
  "color": {
    "$type": "color",
    "void": { "$value": "#000000", "$description": "The canvas, and the lowest surface." },
    "obsidian": { "$value": "#0a0a0a", "$description": "Page background." },
    "deep-tide": { "$value": "#111111", "$description": "Cards and low containers." },
    "tide": { "$value": "#171717", "$description": "Container, and card hover." },
    "raised-tide": { "$value": "#1c1c1c", "$description": "Inputs and raised containers." },
    "high-tide": { "$value": "#242424", "$description": "Highest container." },
    "bright-tide": { "$value": "#2a2a2a", "$description": "Brightest surface." },
    "first-light": { "$value": "#ededed", "$description": "Main text on dark (16.9:1 on obsidian)." },
    "mist": { "$value": "#a3a3a3", "$description": "Secondary text (7.9:1 on obsidian)." },
    "slate-label": { "$value": "#8f8f8f", "$description": "Labels and outlines (6.1:1 on obsidian). The dimmest colour allowed for text." },
    "hairline": { "$value": "#3d3d3d", "$description": "1px dividers and the logo ring on cyan. Never text." },
    "logo-ring": { "$value": "#707070", "$description": "Logo ring for the white and black tones. A graphic, not text (4.2:1 on black, so never use it for text)." },
    "equinox-cyan": { "$value": "#8ff5ff", "$description": "The one accent: the primary action and the logo disc." },
    "equinox-cyan-deep": { "$value": "#00deec", "$description": "Cyan for hover and pressed states." },
    "equinox-cyan-on-light": { "$value": "#00789e", "$description": "Cyan used on light backgrounds (logo on light only)." },
    "ink-on-cyan": { "$value": "#005d63", "$description": "Text on a cyan fill." },
    "cosmic-blue": { "$value": "#9492ff", "$description": "Secondary accent." },
    "signal-lime": { "$value": "#beee00", "$description": "An end state only: done, live, the goal. Never decoration." },
    "alert-coral": { "$value": "#ff716c", "$description": "Errors, and the low step of a rating scale." },
    "signal-amber": { "$value": "#ffd45c", "$description": "Warnings, and the middle step of a rating scale (bad coral, good amber, excellent lime). Never decoration or a second accent." },
    "chart": {
      "1": { "$value": "#c47524" },
      "2": { "$value": "#0f98a6" },
      "3": { "$value": "#7a9700" },
      "4": { "$value": "#5585ff" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Space Grotesk", "sans-serif"], "$description": "Headlines, the wordmark, buttons." },
      "body": { "$value": ["Inter", "sans-serif"], "$description": "Body copy." },
      "mono": { "$value": ["Space Mono", "monospace"], "$description": "Labels, metadata, numbers in the lab style." }
    }
  },
  "typography": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "clamp(3rem, 9vw, 8rem)", "fontWeight": 700, "lineHeight": 0.9, "letterSpacing": "-0.05em" } },
    "headline": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "clamp(1.875rem, 4vw, 3rem)", "fontWeight": 700, "lineHeight": 0.95, "letterSpacing": "-0.05em" } },
    "title": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "1.5rem", "fontWeight": 700, "lineHeight": 1.1, "letterSpacing": "-0.025em" } },
    "body": { "$value": { "fontFamily": "{font.family.body}", "fontSize": "1.125rem", "fontWeight": 400, "lineHeight": 1.625, "letterSpacing": "0" } },
    "body-sm": { "$value": { "fontFamily": "{font.family.body}", "fontSize": "15px", "fontWeight": 400, "lineHeight": 1.6, "letterSpacing": "0" } },
    "label": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.4, "letterSpacing": "0.1em" } },
    "label-sm": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "11px", "fontWeight": 400, "lineHeight": 1.4, "letterSpacing": "0.15em" } },
    "label-lg": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "13px", "fontWeight": 500, "lineHeight": 1.6, "letterSpacing": "0.05em" } }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px", "$description": "Every corner: web, reels, covers, print." },
    "full": { "$value": "9999px", "$description": "Only for things that are circles by nature (avatars, dots)." }
  },
  "space": {
    "$type": "dimension",
    "hairline": { "$value": "1px" },
    "gutter": { "$value": "24px" },
    "card": { "$value": "24px" },
    "card-lg": { "$value": "40px" },
    "section": { "$value": "64px" },
    "section-lg": { "$value": "96px" }
  }
}
